# Synthetic local-development values only. Never commit a real .env or real secrets.
NODE_ENV=development
API_PORT=3001
# Origin(s) allowed to call the API from a browser (comma-separated, no trailing slash).
WEB_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql://eversoft:eversoft_local_dev@localhost:5432/eversoft?schema=public
LOG_LEVEL=info

# --- Phase 2: authentication (docs/02 §5) ---
# SYNTHETIC placeholder only. Generate a real random 32+ byte secret per environment and
# inject it via the environment/secret manager; never commit a real value. The API refuses
# to boot with this exact placeholder when NODE_ENV=production.
AUTH_JWT_SECRET=dev-only-synthetic-insecure-jwt-signing-secret-change-me-0000000000
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_DAYS=30
# Argon2id parameters (OWASP minimum-recommendation defaults).
ARGON2_MEMORY_COST_KB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
# In-memory rate limiting (no Redis; see CLAUDE.md §3) for login/register/forgot-password/
# reset-password.
AUTH_RATE_LIMIT_TTL_SECONDS=60
AUTH_RATE_LIMIT_MAX=5

# --- Phase 3: public calculators (docs/11 §4) ---
# In-memory rate limiting (no Redis) for the public affordability/property-cost/rent-vs-buy
# endpoints. More generous than the auth limits: these are pure computation, no credentials
# or PII, so the limit is only there to bound scripted abuse.
CALCULATOR_RATE_LIMIT_TTL_SECONDS=60
CALCULATOR_RATE_LIMIT_MAX=60

# --- Phase 4: agent widgets and public attribution (docs/06, docs/11 §5) ---
# In-memory rate limiting (no Redis) for the public widget-config and analytics-event
# endpoints, independent of the calculator/auth limits.
WIDGET_CONFIG_RATE_LIMIT_TTL_SECONDS=60
WIDGET_CONFIG_RATE_LIMIT_MAX=120
ANALYTICS_RATE_LIMIT_TTL_SECONDS=60
ANALYTICS_RATE_LIMIT_MAX=60

# --- Phase 5: consent and lead capture (docs/07, docs/08, docs/11 §6) ---
# SYNTHETIC placeholder only, same rejection-in-production pattern as AUTH_JWT_SECRET above.
# Keys lead/suppression deduplication match tokens (keyed HMAC-SHA256) -- must differ from
# AUTH_JWT_SECRET in a real deployment.
LEAD_MATCH_HMAC_SECRET=dev-only-synthetic-insecure-lead-match-hmac-secret-change-me-0000000000
# In-memory rate limiting (no Redis) for the public lead-submission endpoint. Tighter than
# the calculator/widget-config limits: this is a write that accepts contact information from
# an anonymous visitor.
LEAD_SUBMIT_RATE_LIMIT_TTL_SECONDS=60
LEAD_SUBMIT_RATE_LIMIT_MAX=30

# --- Phase 6: exclusive lender delivery, mock routing/delivery adapter (docs/08 §5-6) ---
# Passed through to the mock delivery adapter's contract (never actually a blocking real
# network timeout -- the adapter never makes a real network call; CLAUDE.md §3, docs/11 Gate 6).
DELIVERY_TIMEOUT_MS=5000
# Additional attempts after the first, for the one retryable error category only. Simple,
# synchronous, fixed backoff -- no Redis/queue (CLAUDE.md §3).
DELIVERY_MAX_RETRIES=2
DELIVERY_RETRY_BACKOFF_MS=25

# Used by docker-compose.yml (local PostgreSQL only).
POSTGRES_USER=eversoft
POSTGRES_PASSWORD=eversoft_local_dev
POSTGRES_DB=eversoft
